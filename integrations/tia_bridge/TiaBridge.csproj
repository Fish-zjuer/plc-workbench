<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OpennessDir Condition="'$(OpennessDir)' == '' and '$(TIA_OPENNESS_DIR)' != ''">$(TIA_OPENNESS_DIR)</OpennessDir>
    <OpennessDir Condition="'$(OpennessDir)' == ''">$(ProgramFiles)\Siemens\Automation\Portal V21\PublicAPI\V21\net48</OpennessDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="runtime/**/*.cs" />
    <ProjectReference Include="runtime/TiaRuntime.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(OpennessDir)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(OpennessDir)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="CopyRuntimeHost" AfterTargets="Build">
    <ItemGroup>
      <RuntimeHostFiles Include="$(MSBuildThisFileDirectory)runtime/bin/$(Configuration)/net48/TiaRuntime.exe" />
      <RuntimeHostFiles Include="$(MSBuildThisFileDirectory)runtime/bin/$(Configuration)/net48/TiaRuntime.exe.config" Condition="Exists('$(MSBuildThisFileDirectory)runtime/bin/$(Configuration)/net48/TiaRuntime.exe.config')" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeHostFiles)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
