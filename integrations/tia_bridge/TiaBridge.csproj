<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OpennessDir Condition="'$(OpennessDir)' == '' and '$(TIA_OPENNESS_DIR)' != ''">$(TIA_OPENNESS_DIR)</OpennessDir>
    <OpennessDir Condition="'$(OpennessDir)' == ''">$(ProgramFiles)\Siemens\Automation\Portal V21\PublicAPI\V21\net48</OpennessDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(OpennessDir)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(OpennessDir)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
