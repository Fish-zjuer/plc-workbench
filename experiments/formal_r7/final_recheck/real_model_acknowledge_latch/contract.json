{
  "schema": "plc-task-v1",
  "title": "报警确认不能吞掉仍在持续的故障",
  "block": "AcknowledgeLatch",
  "target": "portable",
  "requirements": [
    {
      "id": "R1",
      "text": "alarm is initially FALSE. fault TRUE sets and holds alarm TRUE, dominating any simultaneous acknowledge edge."
    },
    {
      "id": "R2",
      "text": "When fault is FALSE, a rising edge of acknowledge clears alarm. Without such an edge, alarm retains its state."
    },
    {
      "id": "R3",
      "text": "Acknowledge edge history updates on every scan, even while fault is active. A held acknowledge must not clear alarm after fault disappears; release and press again. Previous acknowledge is initially FALSE."
    }
  ],
  "inputs": {
    "fault": "BOOL",
    "acknowledge": "BOOL"
  },
  "outputs": {
    "alarm": "BOOL"
  },
  "scenarios": [
    {
      "name": "fault_dominates_acknowledge",
      "covers": [
        "R1",
        "R2",
        "R3"
      ],
      "trace": [
