          "proposal": {
            "id": "ADV-1",
            "title": "Debounce timing completes one invocation later than specified continuous duration",
            "basis": "TON is called at the top of each cycle, then VFD_RUN samples rtTimer.Q. On the invocation where the accumulated input-valid time first reaches DebounceTime, the TON.Q reflects the state computed at the start of that scan, so it becomes TRUE only on the following invocation. The requirement says to accept the viscosity condition after VISCOSITY_OK has remained TRUE for DebounceTime, i.e., it should be valid at the end of the qualifying interval, not one cycle later. A trace where the sum of CycleTime first meets DebounceTime cannot demonstrate the mandated behavior, so the timing boundary is unspecified.",
            "scope": "ambiguous",
            "trace": [
              {
                "time_ms": 0,
                "inputs": {
                  "VISCOSITY_OK": 1,
                  "PASTE_E_STOP_NC": 1,
                  "DebounceTime": 100,
                  "CycleTime": 100
