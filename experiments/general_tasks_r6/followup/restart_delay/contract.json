{
  "schema": "plc-task-v1",
  "title": "中断后重新计时的启动延时",
  "block": "RestartDelay",
  "target": "portable",
  "requirements": [
    {
      "id": "R1",
      "text": "running becomes TRUE only after request TRUE and inhibit FALSE remain continuously eligible for delay. A TON starts elapsed=0 on its first eligible invocation."
    },
    {
      "id": "R2",
      "text": "request FALSE or inhibit TRUE immediately sets running FALSE and resets the elapsed waiting time."
    },
    {
      "id": "R3",
      "text": "After interruption, recovery must wait the full delay again, even when request was held TRUE. At exactly delay elapsed running is TRUE."
    }
  ],
  "inputs": {
    "request": "BOOL",
    "inhibit": "BOOL",
    "delay": "TIME"
  },
  "outputs": {
    "running": "BOOL"
  },
  "scenarios": [
    {
      "name": "threshold_and_restart",
      "covers": [
        "R1",
        "R2",
        "R3"
      ],
      "trace": [
        {
          "time_ms": 0,
          "inputs": {
            "request": true,
            "inhibit": false,
            "delay": 20
          },
          "expect": {
            "running": false
          }
        },
        {
          "time_ms": 19,
          "inputs": {
            "request": true,
            "inhibit": false,
            "delay": 20
          },
          "expect": {
            "running": false
          }
        },
        {
          "time_ms": 20,
          "inputs": {
            "request": true,
            "inhibit": false,
            "delay": 20
          },
          "expect": {
            "running": true
          }
