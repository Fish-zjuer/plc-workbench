  "properties": [
    {
      "id": "P_OFF",
      "requirement": "R2",
      "when": {
        "inputs.request": false
      },
      "then": {
        "outputs.running": false
      }
    },
    {
      "id": "P_INHIBIT",
      "requirement": "R2",
      "when": {
        "inputs.inhibit": true
      },
      "then": {
        "outputs.running": false
      }
    }
  ],
  "assumptions": [
    "delay is constant during each eligible waiting interval; inputs may change between scans."
  ],
  "questions": [],
  "executor": "offline",
  "inouts": {},
  "tolerance": 1e-06
