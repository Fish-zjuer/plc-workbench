  ],
  "properties": [
    {
      "id": "P_STOP",
      "requirement": "R2",
      "when": {
        "inputs.stop": true
      },
      "then": {
        "outputs.running": false
      }
    },
    {
      "id": "P_INTERLOCK",
      "requirement": "R2",
      "when": {
        "inputs.permit": false
      },
      "then": {
        "outputs.running": false
      }
    }
  ],
  "assumptions": [
    "This is a software control example; no safety-rated emergency-stop or physical actuator is modeled."
  ],
  "questions": [],
