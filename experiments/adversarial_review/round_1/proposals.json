  "findings": [
    {
      "id": "ADV-001",
      "profile": "moving_average",
      "title": "Trigger rising edge during reset is consumed",
      "claim": "A trigger rising edge while reset is TRUE may be consumed even though reset suppresses sampling; holding trigger TRUE after reset deasserts then produces no sample. Confirm whether reset is specified to dominate sampling or whether this loses a required trigger event.",
      "requirement_basis": "Provide an external trigger signal trigger, which reads a new data value and updates the moving average upon each rising edge. The reset clause says reset resets the moving average calculation when TRUE but does not specify precedence when reset and a trigger edge coincide.",
      "scope": "ambiguous",
      "rationale": "TriggerRise and PreviousTrigger are updated before the reset branch. Thus the scan with the edge during reset clears averaging history but does not sample; on the following scan, if trigger remains TRUE and cyclicExecution is FALSE, there is no new rising edge and no sample. This is a concrete probe of an unspecified interaction, not a confirmed violation. The asserted outputs are those following the candidate behavior and should be adjudicated against any intended reset/trigger precedence.",
      "scenario": {
        "name": "trigger_edge_while_reset_then_held",
        "trace": [
          {
            "time_ms": 0,
            "cyclicExecution": 0,
            "trigger": 0,
            "value": 5.0,
            "windowSize": 2,
            "reset": 1
          },
          {
            "time_ms": 10,
            "cyclicExecution": 0,
            "trigger": 1,
            "value": 10.0,
            "windowSize": 2,
            "reset": 1
          },
          {
            "time_ms": 20,
            "cyclicExecution": 0,
            "trigger": 1,
            "value": 20.0,
            "windowSize": 2,
            "reset": 0
          }
        ]
      },
