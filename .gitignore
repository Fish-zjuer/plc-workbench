# Local runtime state, credentials, full TIA project copies and raw run logs.
# Private configuration and installed runtimes
/agent_data/
/.venv/
/.runtime/
/vendor/wheels/
.env
.env.*
!.env.example

# Generated results, reports and workspace scratch files
/outputs/**
!/outputs/README.md
/reports/*
# Curated, hash-verified assignment evidence is intentional source history.
!/reports/tia_phase3_20261101/
/experiments/
/.tmp-tests/
/tmp/
# Local developer regression tests; assignment cases stay in datasets/course32.json.
/tests/
/PLC-team-package-*/
*.validation.json
*.log
*.log.tmp
*.tmp

# Python, JavaScript and editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.idea/
.vscode/
Thumbs.db
.DS_Store
~$*

# CODESYS generated images, monitoring settings and build caches
*.app
*.crc
*.opt
*.precompilecache
*.compileinfo
*.bootinfo
*.bootinfo_guids
*.~u
*.projectarchive

# Downloaded archives; course source archives are intentional inputs
*.zip
!/course_materials/*.zip

# Keep optional_local_tests/ and plc_agent/legacy/ as source code.
# They are removable source directories, not generated runtime output.

# TIA bridge build output and Visual Studio per-user state.
/integrations/tia_bridge/**/bin/
/integrations/tia_bridge/**/obj/
/integrations/tia_bridge/**/.vs/
/integrations/tia_bridge/**/*.user
/integrations/tia_bridge/**/*.suo
/integrations/tia_bridge/**/*.userosscache
/integrations/tia_bridge/**/*.sln.docstates

# Optional ad-hoc TIA evidence directories; the curated acceptance report stays tracked.
/reports/tia_runs/
/reports/tia_checks/
