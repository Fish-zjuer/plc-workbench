# Private configuration and installed runtimes
/agent_data/
/.venv/
/.runtime/
/vendor/wheels/
.env
.env.*
!.env.example

# Generated results, reports and workspace scratch files
/outputs/**
!/outputs/README.md
/reports/
/experiments/
/.tmp-tests/
/tmp/
# Regression source stays versioned; only generated test caches are ignored.
/PLC-team-package-*/
*.validation.json
*.log
*.log.tmp
/events.jsonl
*.tmp

# Python, JavaScript and editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.idea/
.vscode/
Thumbs.db
.DS_Store
~$*

# CODESYS generated images, monitoring settings and build caches
*.app
*.crc
*.opt
*.precompilecache
*.compileinfo
*.bootinfo
*.bootinfo_guids
*.~u
*.projectarchive

# Downloaded archives; course source archives are intentional inputs
*.zip
!/course_materials/*.zip

# Keep optional_local_tests/ and plc_agent/legacy/ as source code.
# They are removable source directories, not generated runtime output.
