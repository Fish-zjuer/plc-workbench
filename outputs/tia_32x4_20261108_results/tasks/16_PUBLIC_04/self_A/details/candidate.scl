FUNCTION_BLOCK "Q04"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   VISCOSITY_OK : BOOL;
   PASTE_E_STOP_NC : BOOL;
   DebounceTime : TIME;
   CycleTime : TIME;
END_VAR
VAR_OUTPUT
   VFD_RUN : BOOL;
   PUMP_MAINT_DUE : BOOL;
   PUMP_RUNTIME_ACC : TIME;
END_VAR
VAR
   debTimer : TON_TIME;
   debounced : BOOL;
   initDone : BOOL;
   runtimeAccMs : DInt;
   maintDue : BOOL;
END_VAR
BEGIN
   // 上电初始化：运行关闭、累计清零、维护指示 FALSE
   IF NOT #initDone THEN
      #initDone := TRUE;
      #VFD_RUN := FALSE;
      #runtimeAccMs := 0;
      #maintDue := FALSE;
      #debounced := FALSE;
   END_IF;

   // 黏度消抖：连续有效 DebounceTime 后有效；输入 FALSE 立即失效
   IF NOT #VISCOSITY_OK THEN
      #debTimer.TON(IN := FALSE, PT := #DebounceTime);
      #debounced := FALSE;
   ELSE
      #debTimer.TON(IN := TRUE, PT := #DebounceTime);
      #debounced := #debTimer.Q;
   END_IF;

   // 急停优先：立即禁运行并清除不完整消抖计时
   IF NOT #PASTE_E_STOP_NC THEN
      #VFD_RUN := FALSE;
      #debounced := FALSE;
      #debTimer.TON(IN := FALSE, PT := #DebounceTime);
   ELSE
      #VFD_RUN := #debounced;
   END_IF;

   // 运行时累加：仅运行且 CycleTime 为正时累加，停机保持
   IF #VFD_RUN AND (#CycleTime > T#0ms) THEN
      #runtimeAccMs := #runtimeAccMs + TIME_TO_DINT(#CycleTime);
   END_IF;

   // 维护到期指示：达到 500 小时 = 1,800,000,000 ms，不影响运行与安全许可
   IF #runtimeAccMs >= 1800000000 THEN
      #maintDue := TRUE;
   ELSE
      #maintDue := FALSE;
   END_IF;

   #PUMP_MAINT_DUE := #maintDue;
   #PUMP_RUNTIME_ACC := DINT_TO_TIME(#runtimeAccMs);
END_FUNCTION_BLOCK