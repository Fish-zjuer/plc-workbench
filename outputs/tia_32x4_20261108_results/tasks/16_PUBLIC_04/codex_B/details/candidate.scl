FUNCTION_BLOCK "Q04"
  VERSION : 0.1

VAR_INPUT
    VISCOSITY_OK : BOOL;
    PASTE_E_STOP_NC : BOOL;
    DebounceTime : TIME;
    CycleTime : TIME;
END_VAR

VAR_OUTPUT
    VFD_RUN : BOOL;
    PUMP_MAINT_DUE : BOOL;
    PUMP_RUNTIME_ACC : LTIME;
END_VAR

VAR
    VisTimer : TON_TIME;
    ElapsedVis : LTIME;
    MaintLimitMs : LTIME;
END_VAR

BEGIN
    IF NOT VISCOSITY_OK THEN
        ElapsedVis := LT#0ms;
    ELSIF VFD_RUN OR (NOT PASTE_E_STOP_NC) THEN
        ElapsedVis := LT#0ms;
    END_IF;

    VisTimer(IN := VISCOSITY_OK AND PASTE_E_STOP_NC, PT := DebounceTime);

    IF VisTimer.Q THEN
        ElapsedVis := TIME_TO_LTIME(DebounceTime);
    END_IF;

    IF (ElapsedVis >= TIME_TO_LTIME(DebounceTime)) AND PASTE_E_STOP_NC THEN
        VFD_RUN := TRUE;
    ELSE
        VFD_RUN := FALSE;
    END_IF;

    IF VFD_RUN THEN
        PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + TIME_TO_LTIME(CycleTime);
    END_IF;

    MaintLimitMs := LT#1800000000ms;

    IF PUMP_RUNTIME_ACC >= MaintLimitMs THEN
        PUMP_MAINT_DUE := TRUE;
    ELSE
        PUMP_MAINT_DUE := FALSE;
    END_IF;
END_FUNCTION_BLOCK
