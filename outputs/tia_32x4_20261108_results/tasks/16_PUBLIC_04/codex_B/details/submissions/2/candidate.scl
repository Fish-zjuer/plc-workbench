FUNCTION_BLOCK "Q04"
  VERSION : 0.1

VAR_INPUT
    VISCOSITY_OK : BOOL;
    PASTE_E_STOP_NC : BOOL;
    DebounceTime : TIME;
    CycleTime : TIME;
END_VAR

VAR_OUTPUT
    VFD_RUN : BOOL;
    PUMP_MAINT_DUE : BOOL;
    PUMP_RUNTIME_ACC : LTIME;
END_VAR

BEGIN
    VFD_RUN := FALSE;
    PUMP_MAINT_DUE := FALSE;
    PUMP_RUNTIME_ACC := LT#1s;
END_FUNCTION_BLOCK
