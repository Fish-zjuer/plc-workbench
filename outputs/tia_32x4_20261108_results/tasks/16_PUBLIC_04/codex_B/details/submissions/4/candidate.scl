FUNCTION_BLOCK "Q04"
  VERSION : 0.1

VAR_INPUT
    VISCOSITY_OK : BOOL;
    PASTE_E_STOP_NC : BOOL;
    DebounceTime : TIME;
    CycleTime : TIME;
END_VAR

VAR_OUTPUT
    VFD_RUN : BOOL;
    PUMP_MAINT_DUE : BOOL;
    PUMP_RUNTIME_ACC : DINT;
END_VAR

VAR
    VisTimer : TON_TIME;
END_VAR

BEGIN
    VisTimer(IN := VISCOSITY_OK, PT := DebounceTime);

    IF VisTimer.Q THEN
        VFD_RUN := PASTE_E_STOP_NC;
    ELSE
        VFD_RUN := FALSE;
    END_IF;

    IF VFD_RUN THEN
        PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + TIME_TO_DINT(CycleTime) / 1000;
    END_IF;

    IF PUMP_RUNTIME_ACC >= 1800000000 THEN
        PUMP_MAINT_DUE := TRUE;
    ELSE
        PUMP_MAINT_DUE := FALSE;
    END_IF;
END_FUNCTION_BLOCK
