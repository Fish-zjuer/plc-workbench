FUNCTION_BLOCK "FB_CrusherExtraction"
VERSION : 0.1
   VAR_INPUT
      Enable : BOOL;
      Trip : BOOL;
      FeedDemand : LREAL;
      FeedActual : LREAL;
      ExtractionCapacity : LREAL;
   END_VAR
   VAR_OUTPUT
      FeedSP : LREAL;
      ExtractionSP : LREAL;
      Error : BOOL;
   END_VAR

BEGIN
    IF (NOT #Enable) OR #Trip THEN
        #FeedSP := 0.0;
        #ExtractionSP := 0.0;
        #Error := FALSE;
    ELSIF (#FeedDemand < 0.0) OR (#FeedDemand > 100.0)
          OR (#FeedActual < 0.0) OR (#FeedActual > 100.0)
          OR (#ExtractionCapacity < 0.0) OR (#ExtractionCapacity > 100.0) THEN
        #FeedSP := 0.0;
        #ExtractionSP := 0.0;
        #Error := TRUE;
    ELSE
        IF #FeedDemand <= #ExtractionCapacity THEN
            #FeedSP := #FeedDemand;
        ELSE
            #FeedSP := #ExtractionCapacity;
        END_IF;
        IF #FeedDemand >= #FeedActual THEN
            #ExtractionSP := #FeedDemand;
        ELSE
            #ExtractionSP := #FeedActual;
        END_IF;
        #Error := FALSE;
    END_IF;
END_FUNCTION_BLOCK
