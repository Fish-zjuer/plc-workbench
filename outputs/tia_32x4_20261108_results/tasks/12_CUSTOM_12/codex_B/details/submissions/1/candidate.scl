FUNCTION_BLOCK "FB_BuoyPowerBudget"
  VERSION : 0.1
  VAR_INPUT
    Enable : BOOL;
    BudgetW : UINT;
    NeedSensor : BOOL;
    NeedHeater : BOOL;
    NeedRadio : BOOL;
    MandatorySensor : BOOL;
  END_VAR
  VAR_OUTPUT
    SelectedMask : USINT;
    SensorOn : BOOL;
    HeaterOn : BOOL;
    RadioOn : BOOL;
    PowerW : UINT;
    Score : USINT;
    BudgetShortage : BOOL;
    Error : BOOL;
  END_VAR
  VAR_TEMP
    i : INT;
    Mask : USINT;
    Eligible : USINT;
    Pow : UINT;
    Scr : USINT;
    Feasible : BOOL;
    HaveBest : BOOL;
    BestMask : USINT;
    BestPow : UINT;
    BestScr : USINT;
  END_VAR
BEGIN
    #SelectedMask := USINT#0;
    #SensorOn := FALSE;
    #HeaterOn := FALSE;
    #RadioOn := FALSE;
    #PowerW := 0;
    #Score := USINT#0;
    #BudgetShortage := FALSE;
    #Error := FALSE;
    #HaveBest := FALSE;
    #BestMask := USINT#0;
    #BestPow := 0;
    #BestScr := USINT#0;
    IF NOT #Enable THEN
        RETURN;
    ELSIF #BudgetW > 200 THEN
        #Error := TRUE;
        RETURN;
    END_IF;
    IF #MandatorySensor AND (#BudgetW < 40) THEN
        #BudgetShortage := TRUE;
        RETURN;
    END_IF;
    #Eligible := USINT#0;
    IF #NeedSensor OR #MandatorySensor THEN
        #Eligible := #Eligible OR USINT#1;
    END_IF;
    IF #NeedHeater THEN
        #Eligible := #Eligible OR USINT#2;
    END_IF;
    IF #NeedRadio THEN
        #Eligible := #Eligible OR USINT#4;
    END_IF;
    FOR #i := 0 TO 7 DO
        #Mask := INT_TO_USINT(#i);
        #Pow := 0;
        #Scr := USINT#0;
        IF (#Mask AND USINT#1) <> USINT#0 THEN
            #Pow := #Pow + 40;
            #Scr := #Scr + USINT#7;
        END_IF;
        IF (#Mask AND USINT#2) <> USINT#0 THEN
            #Pow := #Pow + 70;
            #Scr := #Scr + USINT#10;
        END_IF;
        IF (#Mask AND USINT#4) <> USINT#0 THEN
            #Pow := #Pow + 60;
            #Scr := #Scr + USINT#9;
        END_IF;
        #Feasible := ((#Mask AND (NOT #Eligible)) = USINT#0) AND (#Pow <= #BudgetW);
        IF #MandatorySensor AND ((#Mask AND USINT#1) = USINT#0) THEN
            #Feasible := FALSE;
        END_IF;
        IF #Feasible THEN
            IF (NOT #HaveBest) OR (#Scr > #BestScr) OR ((#Scr = #BestScr) AND (#Pow < #BestPow)) OR ((#Scr = #BestScr) AND (#Pow = #BestPow) AND (#Mask < #BestMask)) THEN
                #HaveBest := TRUE;
                #BestScr := #Scr;
                #BestPow := #Pow;
                #BestMask := #Mask;
            END_IF;
        END_IF;
    END_FOR;
    #SelectedMask := #BestMask;
    #PowerW := #BestPow;
    #Score := #BestScr;
    #SensorOn := (#SelectedMask AND USINT#1) <> USINT#0;
    #HeaterOn := (#SelectedMask AND USINT#2) <> USINT#0;
    #RadioOn := (#SelectedMask AND USINT#4) <> USINT#0;
END_FUNCTION_BLOCK
