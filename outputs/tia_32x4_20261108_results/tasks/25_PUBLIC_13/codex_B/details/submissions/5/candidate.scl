FUNCTION_BLOCK "Q13"
  VAR_INPUT
    OCCUPANCY_DETECTED : BOOL;    // occupancy detected from CO2 sensor
    ENERGY_SAVING_MODE : BOOL;    // TRUE = energy saving, affects Auto only
    HVAC_MODE_SELECTOR : INT;     // 0 Auto, 1 Comfort, 2 Economy, 3 Night
  END_VAR
  VAR_OUTPUT
    SUPPLY_FAN_RUN : BOOL;
    TEMP_SETPOINT_ADJUST : INT;
  END_VAR
  VAR
    StartTimer : TON_TIME;
    Eligible : BOOL;
  END_VAR

BEGIN
  Eligible := OCCUPANCY_DETECTED AND (HVAC_MODE_SELECTOR <> 3);
  StartTimer(IN := Eligible, PT := T#30s);
  SUPPLY_FAN_RUN := StartTimer.Q;

  IF HVAC_MODE_SELECTOR = 3 THEN
    TEMP_SETPOINT_ADJUST := 4;
  ELSIF OCCUPANCY_DETECTED THEN
    TEMP_SETPOINT_ADJUST := 0;
  ELSIF HVAC_MODE_SELECTOR = 0 THEN
    IF ENERGY_SAVING_MODE THEN
      TEMP_SETPOINT_ADJUST := 3;
    ELSE
      TEMP_SETPOINT_ADJUST := 2;
    END_IF;
  ELSIF HVAC_MODE_SELECTOR = 1 THEN
    TEMP_SETPOINT_ADJUST := 1;
  ELSIF HVAC_MODE_SELECTOR = 2 THEN
    TEMP_SETPOINT_ADJUST := 4;
  ELSE
    TEMP_SETPOINT_ADJUST := 0;
  END_IF;

  IF TEMP_SETPOINT_ADJUST > 4 THEN
    TEMP_SETPOINT_ADJUST := 4;
  ELSIF TEMP_SETPOINT_ADJUST < -4 THEN
    TEMP_SETPOINT_ADJUST := -4;
  END_IF;
END_FUNCTION_BLOCK
