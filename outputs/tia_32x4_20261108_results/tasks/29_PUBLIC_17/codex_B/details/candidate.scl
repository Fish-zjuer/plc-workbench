FUNCTION_BLOCK "Q17"
  VAR_INPUT
    addRecipe : BOOL;
    deleteRecipe : BOOL;
    modifyRecipe : BOOL;
    queryRecipe : BOOL;
    recipeIn : ST_Recipe;
  END_VAR
  VAR_OUTPUT
    recipeAdded : BOOL;
    recipeDeleted : BOOL;
    recipeModified : BOOL;
    recipeQueryResult : ST_Recipe;
    error : BOOL;
    status : WORD;
  END_VAR
  VAR_IN_OUT
    recipe : ARRAY[1..10] OF ST_Recipe;
  END_VAR
  VAR
    i : INT;
    matchIdx : INT;
    freeIdx : INT;
  END_VAR

BEGIN
    #matchIdx := 0;
    #freeIdx := 0;
    FOR #i := 1 TO 10 DO
        IF (#recipe[#i].recipeID <> 0) AND (#recipe[#i].recipeID = #recipeIn.recipeID) THEN
            IF #matchIdx = 0 THEN
                #matchIdx := #i;
            END_IF;
        END_IF;
        IF (#freeIdx = 0) AND (#recipe[#i].recipeID = 0) THEN
            #freeIdx := #i;
        END_IF;
    END_FOR;

    #error := FALSE;
    #status := 16#0000;
    #recipeAdded := FALSE;
    #recipeDeleted := FALSE;
    #recipeModified := FALSE;

    IF #queryRecipe THEN
        IF #matchIdx = 0 THEN
            #error := TRUE;
            #status := 16#8001;
        ELSE
            #recipeQueryResult := #recipe[#matchIdx];
        END_IF;
    ELSIF #addRecipe THEN
        IF #matchIdx <> 0 THEN
            #error := TRUE;
            #status := 16#8002;
        ELSIF #freeIdx = 0 THEN
            #error := TRUE;
            #status := 16#8003;
        ELSE
            #recipe[#freeIdx] := #recipeIn;
            #recipeAdded := TRUE;
        END_IF;
    ELSIF #deleteRecipe THEN
        IF #matchIdx = 0 THEN
            #error := TRUE;
            #status := 16#8004;
        ELSE
            #recipe[#matchIdx].recipeID := 0;
            #recipeDeleted := TRUE;
        END_IF;
    ELSIF #modifyRecipe THEN
        IF #matchIdx = 0 THEN
            #error := TRUE;
            #status := 16#8005;
        ELSE
            #recipe[#matchIdx] := #recipeIn;
            #recipeModified := TRUE;
        END_IF;
    END_IF;
END_FUNCTION_BLOCK
