FUNCTION_BLOCK "FB_CraneSpeedCheck"
VERSION : 0.1
   VAR_INPUT
      LeftSpeed10 : INT;
      RightSpeed10 : INT;
      ReferenceSpeed10 : INT;
   END_VAR
   VAR_OUTPUT
      SyncOK : BOOL;
      SyncBad : BOOL;
      Invalid : BOOL;
   END_VAR
   VAR_TEMP
      ValidInputs : BOOL;
      SyncHolds : BOOL;
      GearHolds : BOOL;
      SideSum : DINT;
      RefTarget : DINT;
      DiffLR : DINT;
      GearDiff : DINT;
   END_VAR
BEGIN
	#ValidInputs := (#LeftSpeed10 >= 0) AND (#LeftSpeed10 <= 100)
	             AND (#RightSpeed10 >= 0) AND (#RightSpeed10 <= 100)
	             AND (#ReferenceSpeed10 > 0) AND (#ReferenceSpeed10 <= 100);

	#SyncOK := FALSE;
	#SyncBad := FALSE;
	#Invalid := FALSE;

	IF NOT #ValidInputs THEN
	    #Invalid := TRUE;
	ELSE
	    #SideSum := DINT#(#LeftSpeed10) + DINT#(#RightSpeed10);
	    #RefTarget := 13 * DINT#(#ReferenceSpeed10);
	    #DiffLR := DINT#(#LeftSpeed10) - DINT#(#RightSpeed10);
	    #GearDiff := #SideSum - #RefTarget;
	    IF #DiffLR < 0 THEN
	        #DiffLR := -#DiffLR;
	    END_IF;
	    IF #GearDiff < 0 THEN
	        #GearDiff := -#GearDiff;
	    END_IF;
	    #SyncHolds := (#DiffLR <= 1);
	    #GearHolds := (#GearDiff <= 2);
	    IF #SyncHolds AND #GearHolds THEN
	        #SyncOK := TRUE;
	    ELSE
	        #SyncBad := TRUE;
	    END_IF;
	END_IF;
END_FUNCTION_BLOCK