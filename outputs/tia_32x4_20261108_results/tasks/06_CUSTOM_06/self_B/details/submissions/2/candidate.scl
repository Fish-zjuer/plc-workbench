FUNCTION_BLOCK "FB_CompressorPressure"
  { S7_Optimized_Access := 'TRUE' }
  VERSION : 0.1

  VAR_INPUT
    Enable : BOOL;
    Reset : BOOL;
    PressureKpa : LREAL;
    AirUseFlow : LREAL;
    Kp : LREAL;
    Ki : LREAL;
    DtSec : LREAL;
  END_VAR

  VAR_OUTPUT
    CapacityPct : LREAL;
    Integral : LREAL;
    Saturated : BOOL;
    Error : BOOL;
  END_VAR

  VAR_TEMP
    e : LREAL;
    FF : LREAL;
    Ic_candidate : LREAL;
    Uc_candidate : LREAL;
    U_final : LREAL;
    valid_inputs : BOOL;
    reject_integration : BOOL;
  END_VAR

BEGIN
    // 1. Check validity of inputs (Range checks implicitly handle NaN/Inf in Siemens logic usually, 
    // but explicit range check is required by spec)
    #valid_inputs := FALSE;
    
    IF (#PressureKpa >= 0.0 AND #PressureKpa <= 1000.0) THEN
        IF (#AirUseFlow >= 0.0 AND #AirUseFlow <= 90.0) THEN
            IF (#Kp >= 0.0 AND #Kp <= 1.0) THEN
                IF (#Ki >= 0.0 AND #Ki <= 0.1) THEN
                    IF (#DtSec >= 0.001 AND #DtSec <= 1.0) THEN
                        #valid_inputs := TRUE;
                    END_IF;
                END_IF;
            END_IF;
        END_IF;
    END_IF;

    // Priority 1: Reset
    IF #Reset THEN
        #Integral := 0.0;
        #CapacityPct := 0.0;
        #Saturated := FALSE;
        #Error := FALSE;
    ELSIF NOT #Enable THEN
        // Priority 2: Disable
        // Preserve Integral
        #CapacityPct := 0.0;
        #Saturated := FALSE;
        #Error := FALSE;
    ELSIF NOT #valid_inputs THEN
        // Priority 3: Invalid Inputs while Enabled
        // Preserve Integral
        #CapacityPct := 0.0;
        #Saturated := FALSE;
        #Error := TRUE;
    ELSE
        // Legal Enabled Call
        #Error := FALSE;

        // Calculate Error term
        #e := 500.0 - #PressureKpa;

        // Calculate Feedforward
        #FF := 2.0 * #AirUseFlow;

        // Candidate Integration Step
        #Ic_candidate := #Integral + (#Ki * #e * #DtSec);

        // Candidate Unclamped Output
        #Uc_candidate := #FF + (#Kp * #e) + #Ic_candidate;

        // Anti-Windup Logic
        // Reject integration step when:
        // (Uc > 100 AND e > 0) OR (Uc < 0 AND e < 0)
        #reject_integration := FALSE;
        
        IF (#Uc_candidate > 100.0 AND #e > 0.0) THEN
            #reject_integration := TRUE;
        ELSIF (#Uc_candidate < 0.0 AND #e < 0.0) THEN
            #reject_integration := TRUE;
        END_IF;

        // Determine Final Integral State
        IF #reject_integration THEN
            // Preserve previous integral (do nothing to #Integral)
        ELSE
            // Accept candidate integral
            #Integral := #Ic_candidate;
        END_IF;

        // Recompute U using final integral
        #U_final := #FF + (#Kp * #e) + #Integral;

        // Set CapacityPct = LIMIT(0, U, 100)
        IF #U_final < 0.0 THEN
            #CapacityPct := 0.0;
        ELSIF #U_final > 100.0 THEN
            #CapacityPct := 100.0;
        ELSE
            #CapacityPct := #U_final;
        END_IF;

        // Set Saturated Flag
        // TRUE only when U is strictly below 0 or above 100
        IF (#U_final < 0.0 OR #U_final > 100.0) THEN
            #Saturated := TRUE;
        ELSE
            #Saturated := FALSE;
        END_IF;
    END_IF;

END_FUNCTION_BLOCK