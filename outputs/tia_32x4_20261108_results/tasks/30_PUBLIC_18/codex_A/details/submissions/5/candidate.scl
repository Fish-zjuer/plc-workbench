FUNCTION_BLOCK "Q18"
VERSION : 0.1
VAR_INPUT
    enqueue : BOOL;
    dequeue : BOOL;
    reset : BOOL;
END_VAR
VAR_OUTPUT
    elementCount : DINT;
    status : WORD;
END_VAR
VAR_IN_OUT
    item : VARIANT;
    buffer : VARIANT;
END_VAR
VAR
    statEnqueueEdge : BOOL;
    statDequeueEdge : BOOL;
    statHead : DINT;
    statCount : DINT;
    statCapacity : DINT;
    statReady : BOOL;
    statTmp : DINT;
    statBase : DWORD;
    statItemPtr : DWORD;
END_VAR
BEGIN
    IF NOT #statReady THEN
        #statCapacity := CountOfElements(#buffer);
        #statBase := VariantGet(#buffer);
        #statItemPtr := VariantGet(#item);
        #statReady := TRUE;
    END_IF;
    #statTmp := 0;
    #statTmp.%D0 := 1;
    #elementCount := #statCount;
    #status := 16#0000;
    #statEnqueueEdge := #enqueue;
    #statDequeueEdge := #dequeue;
END_FUNCTION_BLOCK
