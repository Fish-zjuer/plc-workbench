FUNCTION_BLOCK "Q18"
VERSION : 0.1
VAR_INPUT
    enqueue : BOOL;
    dequeue : BOOL;
    reset : BOOL;
END_VAR
VAR_OUTPUT
    elementCount : DINT;
    status : WORD;
END_VAR
VAR_IN_OUT
    item : VARIANT;
    buffer : VARIANT;
END_VAR
VAR_TEMP
    n : DINT;
    p : REF_TO Byte;
    bArr : BOOL;
    bNull : BOOL;
    szIt : DINT;
    szBufElem : DINT;
    mem : MemVarType;
END_VAR
BEGIN
    #bArr := isVariantOfType(buffer, Types.ArrayType);
    #bNull := isVariantOfType(item, VoidType);
    #mem := getMemVarType(item);
    #szIt := getSize(#mem);
    #szBufElem := 2 * SIZEOF(REAL);
    #n := #szBufElem + #szIt + SIZEOF(p) + BoolToInt(#bArr) + BoolToInt(#bNull);
    #elementCount := #n;
    #status := 16#0000;
END_FUNCTION_BLOCK
