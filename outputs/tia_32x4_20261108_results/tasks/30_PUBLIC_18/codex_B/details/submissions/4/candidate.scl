FUNCTION_BLOCK "Q18"
VERSION : 0.1
VAR_INPUT
    enqueue : BOOL;
    dequeue : BOOL;
    reset : BOOL;
END_VAR
VAR_OUTPUT
    elementCount : DINT;
    status : WORD;
END_VAR
VAR_IN_OUT
    item : VARIANT;
    buffer : VARIANT;
END_VAR
VAR_TEMP
    n : DINT;
    p : REF_TO TO_VARIANT;
    b : BOOL;
    sz : DINT;
END_VAR
BEGIN
    #n := VariantGetInfo(buffer);
    #p := getVariantRef(Variant := buffer);
    #b := isVariantOfType(buffer, Types.ArrayType);
    #sz := getSizeOF(buffer);
    #elementCount := #n + SIZEOF(#p^) + SIZEOF(#b) + #sz;
    #status := 16#0000;
END_FUNCTION_BLOCK
