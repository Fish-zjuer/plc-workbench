FUNCTION_BLOCK "Q18"
VERSION : 0.1
VAR_INPUT
    enqueue : BOOL;
    dequeue : BOOL;
    reset : BOOL;
END_VAR
VAR_OUTPUT
    elementCount : DINT;
    status : WORD;
END_VAR
VAR_IN_OUT
    item : VARIANT;
    buffer : VARIANT;
END_VAR
VAR_TEMP
    n : DINT;
END_VAR
BEGIN
    #n := VariantGetCount(buffer);
    IF #n > 0 THEN
        #elementCount := #n;
        VariantSetBuffer(buffer, 0, 16#AA);
        #status := 16#0000;
    ELSE
        #status := 16#80FF;
    END_IF;
END_FUNCTION_BLOCK
