FUNCTION_BLOCK "FB_RollGeometry"
VAR_INPUT
    Reset : BOOL;
    InitialD : LREAL;
    Receiving : BOOL;
    EncoderDelta : DINT;
    SpeedMpm : LREAL;
END_VAR
VAR_OUTPUT
    StoredLength : LREAL;
    Diameter : LREAL;
    MotorRPM : LREAL;
    LimitHit : BOOL;
    Error : BOOL;
END_VAR
VAR
    initialized : BOOL := FALSE;
    CoreD : LREAL := 76.0;
    MaxD : LREAL := 140.0;
    Thickness : LREAL := 0.135;
    PI : LREAL := 3.141592653589793;
    MeasRollerDia : LREAL := 50.0;
    PulsesPerRev : REAL := 1024.0;
    Lmax : LREAL;
    deltaL : LREAL;
    rawLength : LREAL;
    validInputs : BOOL;
    doInit : BOOL;
END_VAR
BEGIN
    // Calculate constant Lmax once (could be done in static init but safe here)
    Lmax := PI * (MaxD * MaxD - CoreD * CoreD) / (4.0 * Thickness);

    // Determine if inputs are valid
    // Illegal SpeedMpm or EncoderDelta, or illegal InitialD when initializing
    validInputs := TRUE;
    
    IF (SpeedMpm < -15.0) OR (SpeedMpm > 15.0) THEN
        validInputs := FALSE;
    END_IF;
    
    IF (EncoderDelta < 0) OR (EncoderDelta > 1000000) THEN
        validInputs := FALSE;
    END_IF;
    
    // Check InitialD validity only if we are attempting to initialize
    // Initialization happens on first legal call or when Reset=TRUE
    doInit := (NOT initialized) OR Reset;
    
    IF doInit AND ((InitialD < 76.0) OR (InitialD > 140.0)) THEN
        validInputs := FALSE;
    END_IF;

    IF NOT validInputs THEN
        // Illegal input: Set Error, zero RPM, clear LimitHit, preserve geometry
        Error := TRUE;
        MotorRPM := 0.0;
        LimitHit := FALSE;
        // StoredLength and Diameter remain unchanged from previous cycle
        RETURN;
    ELSE
        // Legal inputs clear Error
        Error := FALSE;
    END_IF;

    IF doInit THEN
        // Initialize geometric estimate
        // Ignore pulse increment on this call
        StoredLength := PI * (InitialD * InitialD - CoreD * CoreD) / (4.0 * Thickness);
        Diameter := InitialD;
        MotorRPM := 0.0;
        LimitHit := FALSE;
        initialized := TRUE;
    ELSE
        // Normal operation: Update length based on encoder
        // deltaL = EncoderDelta * PI * 50 / 1024
        deltaL := INT_TO_REAL(EncoderDelta) * PI * MeasRollerDia / PulsesPerRev;
        
        IF Receiving THEN
            rawLength := StoredLength + deltaL;
        ELSE
            rawLength := StoredLength - deltaL;
        END_IF;
        
        // Clamp StoredLength to [0, Lmax]
        // Set LimitHit only if unclamped value is strictly outside interval
        IF rawLength < 0.0 THEN
            StoredLength := 0.0;
            LimitHit := TRUE;
        ELSIF rawLength > Lmax THEN
            StoredLength := Lmax;
            LimitHit := TRUE;
        ELSE
            StoredLength := rawLength;
            LimitHit := FALSE;
        END_IF;
        
        // Compute Diameter from updated length
        // Diameter = SQRT(CoreD^2 + 4*Thickness*StoredLength/PI)
        Diameter := SQRT(CoreD * CoreD + (4.0 * Thickness * StoredLength / PI));
        
        // Compute MotorRPM
        // MotorRPM = SpeedMpm * 1000 * 50 / (PI * Diameter)
        // Note: Diameter is always >= 76 mm due to clamping of length >= 0
        IF Diameter > 0.0 THEN
            MotorRPM := SpeedMpm * 1000.0 * 50.0 / (PI * Diameter);
        ELSE
            MotorRPM := 0.0; // Should not happen given constraints
        END_IF;
        
        // Clamp MotorRPM to [-6000, 6000]
        IF MotorRPM < -6000.0 THEN
            MotorRPM := -6000.0;
        ELSIF MotorRPM > 6000.0 THEN
            MotorRPM := 6000.0;
        END_IF;
    END_IF;
END_FUNCTION_BLOCK