FUNCTION_BLOCK "FB_GateTelemetry"
  VERSION : 0.1
  VAR_INPUT
    Reset : BOOL;
    FrameValid : BOOL;
    FrameSeq : UDINT;
    Ack : BOOL;
    DtMs : UDINT;
    TimeoutMs : UDINT;
  END_VAR
  VAR_OUTPUT
    Fresh : BOOL;
    AgeMs : UDINT := 0;
    CommFault : BOOL := TRUE;
    RemoteWritePermit : BOOL;
    Error : BOOL;
  END_VAR
  VAR
    HaveFrame : BOOL;
    LastSeq : UDINT;
  END_VAR

BEGIN
    IF Reset THEN
        HaveFrame := FALSE;
        LastSeq := 0;
        Fresh := FALSE;
        AgeMs := 0;
        CommFault := TRUE;
        RemoteWritePermit := FALSE;
        Error := FALSE;
    ELSIF (DtMs < 1) OR (DtMs > 1000) OR (TimeoutMs < 1) OR (TimeoutMs > 60000) THEN
        Error := TRUE;
        Fresh := FALSE;
        CommFault := TRUE;
        RemoteWritePermit := FALSE;
    ELSE
        Error := FALSE;
        IF FrameValid AND (NOT HaveFrame OR (FrameSeq <> LastSeq)) THEN
            Fresh := TRUE;
            AgeMs := 0;
            IF HaveFrame AND Ack THEN
                CommFault := FALSE;
            END_IF;
            HaveFrame := TRUE;
            LastSeq := FrameSeq;
        ELSE
            Fresh := FALSE;
            IF AgeMs <= (60000 - DtMs) THEN
                AgeMs := AgeMs + DtMs;
            ELSE
                AgeMs := 60000;
            END_IF;
        END_IF;
        IF AgeMs >= TimeoutMs THEN
            CommFault := TRUE;
        END_IF;
        RemoteWritePermit := NOT CommFault AND (AgeMs < TimeoutMs);
    END_IF;
END_FUNCTION_BLOCK
