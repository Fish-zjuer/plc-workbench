FUNCTION_BLOCK "FB_ElevatorTarget"
VERSION : 0.1
   VAR_INPUT
      Enable : BOOL;
      CurrentFloor : INT;
      Direction : INT;
      FullLoad : BOOL;
      CabReq : ARRAY[1..6] OF BOOL;
      HallReq : ARRAY[1..6] OF BOOL;
   END_VAR
   VAR_OUTPUT
      HasTarget : BOOL;
      TargetFloor : INT;
      NextDirection : INT;
   END_VAR
   VAR_TEMP
      i : INT;
      f : INT;
      req : ARRAY[1..6] OF BOOL;
      nearAbove : INT;
      nearBelow : INT;
      pai : INT;
      pbi : INT;
      res : INT;
   END_VAR
BEGIN
   f := #CurrentFloor;
   IF #f < 1 THEN
      f := 1;
   END_IF;
   IF #f > 6 THEN
      f := 6;
   END_IF;

   FOR #i := 1 TO 6 DO
      #req[#i] := #CabReq[#i] OR (#HallReq[#i] AND NOT #FullLoad);
   END_FOR;

   #nearAbove := 0;
   #nearBelow := 0;
   FOR #i := 1 TO 6 DO
      IF #req[#i] AND (#i > #f) THEN
         IF (#nearAbove = 0) OR (#i < #nearAbove) THEN
            #nearAbove := #i;
         END_IF;
      END_IF;
      IF #req[#i] AND (#i < #f) THEN
         IF (#nearBelow = 0) OR (#i > #nearBelow) THEN
            #nearBelow := #i;
         END_IF;
      END_IF;
   END_FOR;

   #res := #f;
   IF NOT #req[#f] THEN
      IF #Direction = 1 THEN
         IF #nearAbove > 0 THEN
            #res := #nearAbove;
         ELSIF #nearBelow > 0 THEN
            #res := #nearBelow;
         END_IF;
      ELSIF #Direction = -1 THEN
         IF #nearBelow > 0 THEN
            #res := #nearBelow;
         ELSIF #nearAbove > 0 THEN
            #res := #nearAbove;
         END_IF;
      ELSE
         #pai := #nearAbove;
         #pbi := #nearBelow;
         IF #pai = 0 THEN
            #res := #pbi;
         ELSIF #pbi = 0 THEN
            #res := #pai;
         ELSE
            IF (#pai - #f) <= (#f - #pbi) THEN
               #res := #pai;
            ELSE
               #res := #pbi;
            END_IF;
         END_IF;
      END_IF;
   END_IF;

   #TargetFloor := #res;
   #HasTarget := #Enable AND #res <> #f;
   IF #res > #f THEN
      #NextDirection := 1;
   ELSIF #res < #f THEN
      #NextDirection := -1;
   ELSE
      #NextDirection := 0;
   END_IF;
END_FUNCTION_BLOCK