FUNCTION_BLOCK "Q11"
{
    S7_Optimized_Access := 'TRUE'
}
VERSION : 0.1

VAR_INPUT
    Mode : BOOL;          // 0=Manual, 1=Automatic
    ForwardButton : BOOL;
    ReverseButton : BOOL;
    SensorA : BOOL;
    SensorB : BOOL;
    SensorC : BOOL;
    ButtonA : BOOL;
    ButtonB : BOOL;
    ButtonC : BOOL;
END_VAR

VAR_OUTPUT
    MotorForward : BOOL;
    MotorReverse : BOOL;
    CompletionLight : BOOL;
END_VAR

VAR
    State : INT;          // Internal state: 0=Start/Idle, 1=MovingToB, 2=AtB_Waiting, 3=MovingToC, 4=AtC_Done
    PrevButtonA : BOOL;
    PrevButtonB : BOOL;
    PrevButtonC : BOOL;
    EdgeButtonA : BOOL;
    EdgeButtonB : BOOL;
    EdgeButtonC : BOOL;
END_VAR

BEGIN
    // --- Edge Detection for Buttons ---
    #EdgeButtonA := #ButtonA AND NOT #PrevButtonA;
    #EdgeButtonB := #ButtonB AND NOT #PrevButtonB;
    #EdgeButtonC := #ButtonC AND NOT #PrevButtonC;

    #PrevButtonA := #ButtonA;
    #PrevButtonB := #ButtonB;
    #PrevButtonC := #ButtonC;

    // --- Mode Logic ---
    IF #Mode = FALSE THEN
        // Manual Mode
        // Reset auto state variables if switching from Auto to Manual?
        // Requirements don't specify persistence across mode switches, but typically reset or hold.
        // Let's keep outputs controlled by manual buttons directly.
        
        // Interlock: Cannot be forward and reverse simultaneously
        IF #ForwardButton AND NOT #ReverseButton THEN
            #MotorForward := TRUE;
            #MotorReverse := FALSE;
        ELSIF #ReverseButton AND NOT #ForwardButton THEN
            #MotorForward := FALSE;
            #MotorReverse := TRUE;
        ELSE
            #MotorForward := FALSE;
            #MotorReverse := FALSE;
        END_IF;
        
        // Completion light in manual mode? Usually off or follows sensor C if not in auto sequence.
        // Requirement says completion light turns on after ButtonC in Auto. In Manual, it's safer to turn off or follow Sensor C directly if defined, 
        // but spec implies it's part of the Auto sequence. Let's set it to FALSE in Manual unless specified otherwise.
        // However, P09 says G(done & !SensorC -> R1(!CompletionLight)). This applies globally.
        // If we are in Manual, 'done' state isn't active via the FSM. 
        // Let's assume CompletionLight is only driven by the Auto FSM or explicitly cleared.
        #CompletionLight := FALSE;

    ELSE
        // Automatic Mode
        // Initialize State if needed (e.g., at power up) - assuming State persists.
        
        CASE #State OF
            0:
                // Start / Idle: Waiting for product at A and ButtonA
                #MotorForward := FALSE;
                #MotorReverse := FALSE;
                #CompletionLight := FALSE;
                
                IF #SensorA AND #EdgeButtonA THEN
                    #State := 1; // Move to B
                END_IF;

            1:
                // Moving to B
                #MotorForward := TRUE;
                #MotorReverse := FALSE;
                
                IF #SensorB THEN
                    #MotorForward := FALSE; // Stop motor immediately upon arrival
                    #State := 2;           // Arrived at B
                END_IF;

            2:
                // At B: Waiting for ButtonB
                #MotorForward := FALSE;
                #MotorReverse := FALSE;
                
                IF #EdgeButtonB THEN
                    #State := 3; // Move to C
                END_IF;

            3:
                // Moving to C
                #MotorForward := TRUE;
                #MotorReverse := FALSE;
                
                IF #SensorC THEN
                    #MotorForward := FALSE; // Stop motor immediately upon arrival
                    #State := 4;           // Arrived at C
                END_IF;

            4:
                // At C / Done: Waiting for ButtonC to confirm processing complete
                #MotorForward := FALSE;
                #MotorReverse := FALSE;
                
                IF #EdgeButtonC THEN
                    // Product processed, Light On
                    #CompletionLight := TRUE;
                    // Note: Spec says "When the product is taken away... light turns off".
                    // We stay in State 4 (Done) until product leaves?
                    // Or does taking away reset the line?
                    // Spec: "G(atC & ButtonC -> R1(CompletionLight))"
                    // Spec: "G(done & !SensorC -> R1(!CompletionLight))"
                    // It doesn't explicitly say what happens after light goes off regarding State.
                    // Typically, once product is gone, system might return to Idle (0) or wait for next product at A.
                    // Since SensorA is used to start movement from A, let's assume if SensorC is false, we clear light.
                    // If SensorA becomes true again, do we restart? The FSM needs a path back to 0.
                    // Let's add transition: If product removed (!SensorC), Light OFF. 
                    // If new product arrives at A (SensorA) and we are in Done state, should we move?
                    // Standard behavior: Once done, if product removed, reset to Idle (0).
                    
                    IF NOT #SensorC THEN
                        #CompletionLight := FALSE;
                        #State := 0; // Return to Idle for next cycle
                    END_IF;
                ELSE
                    // If ButtonC hasn't been pressed yet, but product is there, Light remains Off.
                    #CompletionLight := FALSE;
                    
                    // What if product is removed before ButtonC is pressed?
                    IF NOT #SensorC THEN
                         #State := 0; // Abort/Reset
                    END_IF;
                END_IF;

            DEFAULT:
                #State := 0;
                #MotorForward := FALSE;
                #MotorReverse := FALSE;
                #CompletionLight := FALSE;
        END_CASE;
    END_IF;
END_FUNCTION_BLOCK