FUNCTION_BLOCK "Q20"
VERSION : 0.1
   VAR_INPUT
      Mode : Bool;
      ForwardButton : Bool;
      ReverseButton : Bool;
      SensorFeed : Bool;
      SensorWash : Bool;
      SensorWeight : Bool;
      SensorFiring : Bool;
      SensorOutput : Bool;
      washComplete : Bool;
      weightComplete : Bool;
      weight : Real;
      firingComplete : Bool;
   END_VAR
   VAR_OUTPUT
      MotorForward : Bool;
      MotorReverse : Bool;
      kick : Bool;
      CompletionLight : Bool;
      firingTemp : Real;
   END_VAR
   VAR
      step : Int;
      ModeOld : Bool;
      prevStep : Int;
   END_VAR

BEGIN
	IF #Mode <> #ModeOld THEN
	    #ModeOld := #Mode;
	    #step := 0;
	    #kick := FALSE;
	    #CompletionLight := FALSE;
	END_IF;

	IF NOT #Mode THEN
	    #MotorForward := #ForwardButton AND NOT #ReverseButton;
	    #MotorReverse := #ReverseButton AND NOT #ForwardButton;
	    #CompletionLight := #SensorOutput;
	    #step := 0;
	    #kick := FALSE;
	ELSE
        #prevStep := #step;
        IF #prevStep <> #step THEN
            #prevStep := #step;
        END_IF;

        // Arrival detection by the station sensors (in process order)
        IF (#step = 0 OR #step = 1) AND #SensorWash THEN
            #step := 2;
        END_IF;
        IF #step = 0 AND #SensorFeed THEN
            #step := 1;
        END_IF;
        IF #step = 3 AND #SensorWeight THEN
            #step := 4;
        END_IF;
        IF #step = 5 AND #SensorFiring THEN
            #step := 6;
        END_IF;
        IF #step = 7 AND #SensorOutput THEN
            #step := 8;
        END_IF;

        // Completion signals (valid while waiting at the related station)
        IF #step = 2 AND #washComplete THEN
            #step := 3;
        END_IF;
        IF #step = 4 AND #weightComplete THEN
            IF #weight >= 100.0 AND #weight <= 200.0 THEN
                #firingTemp := 500.0 + 0.5 * (#weight - 100.0);
                #step := 5;
            ELSE
                #kick := TRUE;
                #step := 9;
            END_IF;
        END_IF;
        IF #step = 6 AND #firingComplete THEN
            #step := 7;
        END_IF;

        // Remove unqualified product from the line
        IF #step = 9 AND NOT #SensorWeight THEN
            #step := 0;
        END_IF;
        // Finished product removed
        IF #step = 8 AND NOT #SensorOutput THEN
            #step := 0;
        END_IF;

        // Motor commands
        IF #step = 1 OR #step = 3 OR #step = 5 OR #step = 7 THEN
            #MotorForward := TRUE;
        ELSE
            #MotorForward := FALSE;
        END_IF;
        #MotorReverse := FALSE;

        IF #step = 8 THEN
            #CompletionLight := TRUE;
        ELSE
            #CompletionLight := FALSE;
        END_IF;

        IF #step <> 9 THEN
            #kick := FALSE;
        END_IF;
	END_IF;

END_FUNCTION_BLOCK
