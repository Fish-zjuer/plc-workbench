FUNCTION_BLOCK "MultiPumpCtrl"
VERSION : 0.1
VAR_INPUT
    mode : BOOL;
    start : BOOL;
    stop : BOOL;
END_VAR
VAR_IN_OUT
    pumpGroup : ARRAY[1..5] OF ST_Pump;
END_VAR
VAR
    i : INT;
    enabled : BOOL;
    selCnt : INT;
    k : INT;
END_VAR
BEGIN
    IF #stop THEN
        #enabled := FALSE;
    ELSIF #start THEN
        #enabled := TRUE;
    END_IF;
    ;
    IF #stop OR NOT #enabled THEN
        FOR #i := 1 TO 5 DO
            #pumpGroup[#i].RunComd := FALSE;
        END_FOR;
    ELSIF NOT #mode THEN
        FOR #i := 1 TO 5 DO
            #pumpGroup[#i].RunComd := #pumpGroup[#i].selection;
        END_FOR;
    ELSE
        FOR #i := 1 TO 5 DO
            #pumpGroup[#i].RunComd := FALSE;
        END_FOR;
        #selCnt := 0;
        WHILE #selCnt < 3 DO
            #k := 0;
            FOR #i := 1 TO 5 DO
                IF NOT #pumpGroup[#i].RunComd THEN
                    IF #k = 0 OR #pumpGroup[#i].priority > #pumpGroup[#k].priority THEN
                        #k := #i;
                    END_IF;
                END_IF;
            END_FOR;
            IF #k = 0 THEN
                EXIT;
            END_IF;
            #pumpGroup[#k].RunComd := TRUE;
            #selCnt := #selCnt + 1;
        END_WHILE;
    END_IF;
END_FUNCTION_BLOCK
