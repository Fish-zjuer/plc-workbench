FUNCTION_BLOCK "Q07"
  { S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT
    mode : BOOL; // FALSE: Manual, TRUE: Automatic
    start : BOOL;
    stop : BOOL;
END_VAR

VAR_IN_OUT
    pumpGroup : ARRAY[1..5] OF ST_Pump;
END_VAR

VAR_TEMP
    i : INT;
    j : INT;
    tempPriority : INT;
    maxPriority : INT;
    countSelected : INT;
    allOff : BOOL;
    manualOK : BOOL;
    autoOK : BOOL;
    runningIndices : ARRAY[1..5] OF INT;
    numRunning : INT;
    isRunning : ARRAY[1..5] OF BOOL;
    selectedForRun : ARRAY[1..5] OF BOOL;
    priorityArray : ARRAY[1..5] OF INT;
    indexArray : ARRAY[1..5] OF INT;
    swapped : BOOL;
    k : INT;
    minRunPriority : INT;
    maxStandbyPriority : INT;
    standbyFound : BOOL;
END_VAR

VAR
    enabled : BOOL;
END_VAR

BEGIN
    // 1. Enable Latch Logic (Stop Priority)
    IF #stop THEN
        #enabled := FALSE;
    ELSIF #start AND NOT #stop THEN
        #enabled := TRUE;
    END_IF;

    // Initialize helper arrays
    FOR #i := 1 TO 5 DO
        #isRunning[#i] := FALSE;
        #selectedForRun[#i] := FALSE;
        #priorityArray[#i] := #pumpGroup[#i].priority;
        #indexArray[#i] := #i;
    END_FOR;

    // 2. Mode Logic
    IF #enabled THEN
        IF NOT #mode THEN
            // Manual Mode: Run if selection is TRUE
            FOR #i := 1 TO 5 DO
                IF #pumpGroup[#i].selection THEN
                    #selectedForRun[#i] := TRUE;
                ELSE
                    #selectedForRun[#i] := FALSE;
                END_IF;
            END_FOR;
        ELSE
            // Automatic Mode: Select top 3 by priority
            // Sort indices based on priority (Descending Bubble Sort)
            FOR #i := 1 TO 4 DO
                FOR #j := 1 TO 5 - #i DO
                    IF #priorityArray[#j] < #priorityArray[#j + 1] THEN
                        // Swap priorities
                        #tempPriority := #priorityArray[#j];
                        #priorityArray[#j] := #priorityArray[#j + 1];
                        #priorityArray[#j + 1] := #tempPriority;
                        
                        // Swap indices
                        #k := #indexArray[#j];
                        #indexArray[#j] := #indexArray[#j + 1];
                        #indexArray[#j + 1] := #k;
                    END_IF;
                END_FOR;
            END_FOR;

            // Mark top 3 as selected for run
            FOR #i := 1 TO 3 DO
                #selectedForRun[#indexArray[#i]] := TRUE;
            END_FOR;
        END_IF;
    ELSE
        // Disabled: No pumps selected
        FOR #i := 1 TO 5 DO
            #selectedForRun[#i] := FALSE;
        END_FOR;
    END_IF;

    // 3. Write Output RunComd and Update Internal State
    FOR #i := 1 TO 5 DO
        #pumpGroup[#i].RunComd := #selectedForRun[#i];
        #isRunning[#i] := #selectedForRun[#i];
    END_FOR;

END_FUNCTION_BLOCK