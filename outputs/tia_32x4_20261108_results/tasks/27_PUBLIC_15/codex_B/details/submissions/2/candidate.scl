FUNCTION_BLOCK "Q15"
VERSION : 0.1

VAR_INPUT
    estop : BOOL;
    opeMode : BOOL;
    valveAStart : BOOL;
    valveBStart : BOOL;
    valveCStart : BOOL;
    valveDStart : BOOL;
    mixMotorStart : BOOL;
    autoStart : BOOL;
    processMode : BOOL;
    levelSensor : INT;
    mixMotorComplete : BOOL;
END_VAR

VAR_OUTPUT
    valveARun : BOOL;
    valveBRun : BOOL;
    valveCRun : BOOL;
    valveDRun : BOOL;
    mixMotorRun : BOOL;
END_VAR

VAR
    edgeAutoStart : R_TRIG;
    edgeValveA : R_TRIG;
    edgeValveB : R_TRIG;
    edgeValveC : R_TRIG;
    edgeValveD : R_TRIG;
    edgeMixMotor : R_TRIG;
    autoActive : BOOL;
    step : INT := 10;
END_VAR

BEGIN
    // Emergency stop has priority: all equipment off.
    IF NOT estop THEN
        #valveARun := FALSE;
        #valveBRun := FALSE;
        #valveCRun := FALSE;
        #valveDRun := FALSE;
        #mixMotorRun := FALSE;
        #autoActive := FALSE;
        #step := 10;
    ELSIF #opeMode THEN
        // Automatic mode: sequential process control.
        IF #edgeAutoStart(CLK := #autoStart) THEN
            #autoActive := TRUE;
            #step := 10;
        END_IF;
        IF #autoActive THEN
            CASE #step OF
                10: // Valve A filling until level reaches 50 cm.
                    #valveARun := TRUE;
                    #valveBRun := FALSE;
                    #valveCRun := FALSE;
                    #valveDRun := FALSE;
                    #mixMotorRun := FALSE;
                    IF #levelSensor >= 50 THEN
                        #valveARun := FALSE;
                        #valveBRun := TRUE;
                        #step := 20;
                    END_IF;
                20: // Valve B filling until level reaches 80 cm.
                    #valveARun := FALSE;
                    #valveBRun := TRUE;
                    #valveCRun := FALSE;
                    #valveDRun := FALSE;
                    #mixMotorRun := FALSE;
                    IF #levelSensor >= 80 THEN
                        #valveBRun := FALSE;
                        IF #processMode THEN
                            #valveCRun := TRUE;
                            #step := 30;
                        ELSE
                            #mixMotorRun := TRUE;
                            #step := 40;
                        END_IF;
                    END_IF;
                30: // Valve C filling until level reaches 100 cm.
                    #valveARun := FALSE;
                    #valveBRun := FALSE;
                    #valveCRun := TRUE;
                    #valveDRun := FALSE;
                    #mixMotorRun := FALSE;
                    IF #levelSensor >= 100 THEN
                        #valveCRun := FALSE;
                        #mixMotorRun := TRUE;
                        #step := 40;
                    END_IF;
                40: // Mixing until the mixing complete signal arrives.
                    #valveARun := FALSE;
                    #valveBRun := FALSE;
                    #valveCRun := FALSE;
                    #valveDRun := FALSE;
                    #mixMotorRun := TRUE;
                    IF #mixMotorComplete THEN
                        #mixMotorRun := FALSE;
                        #valveDRun := TRUE;
                        #step := 50;
                    END_IF;
                50: // Discharge through valve D, process finished.
                    #valveARun := FALSE;
                    #valveBRun := FALSE;
                    #valveCRun := FALSE;
                    #valveDRun := TRUE;
                    #mixMotorRun := FALSE;
                    #autoActive := FALSE;
                    #step := 10;
                ELSE
                    #step := 10;
            END_CASE;
        END_IF;
    ELSE
        // Manual mode: every button toggles its own output on a rising edge.
        IF #edgeValveA(CLK := #valveAStart) THEN
            #valveARun := NOT #valveARun;
        END_IF;
        IF #edgeValveB(CLK := #valveBStart) THEN
            #valveBRun := NOT #valveBRun;
        END_IF;
        IF #edgeValveC(CLK := #valveCStart) THEN
            #valveCRun := NOT #valveCRun;
        END_IF;
        IF #edgeValveD(CLK := #valveDStart) THEN
            #valveDRun := NOT #valveDRun;
        END_IF;
        IF #edgeMixMotor(CLK := #mixMotorStart) THEN
            #mixMotorRun := NOT #mixMotorRun;
        END_IF;
    END_IF;
END_FUNCTION_BLOCK
