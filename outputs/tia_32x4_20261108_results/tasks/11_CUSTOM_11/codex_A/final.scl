FUNCTION_BLOCK "FB_WeighbridgeVote"
VERSION : 0.1

VAR_INPUT
   LoadA : DINT;
   LoadB : DINT;
   LoadC : DINT;
   ReleaseReq : BOOL;
   BarrierReady : BOOL;
END_VAR

VAR_OUTPUT
   PairMask : USINT;
   VotedKg : LREAL;
   LoadFault : BOOL;
   Overload : BOOL;
   ReleasePermit : BOOL;
END_VAR

VAR_TEMP
   ValidA : BOOL;
   ValidB : BOOL;
   ValidC : BOOL;
   DiffAB : DINT;
   DiffAC : DINT;
   DiffBC : DINT;
   BestMask : USINT;
   BestDiff : DINT;
   Found : BOOL;
END_VAR

BEGIN
   ValidA := (#LoadA >= 0) AND (#LoadA <= 20000);
   ValidB := (#LoadB >= 0) AND (#LoadB <= 20000);
   ValidC := (#LoadC >= 0) AND (#LoadC <= 20000);

   DiffAB := 0;
   DiffAC := 0;
   DiffBC := 0;
   IF ValidA AND ValidB THEN
      DiffAB := #LoadA - #LoadB;
      IF DiffAB < 0 THEN
         DiffAB := -DiffAB;
      END_IF;
   END_IF;
   IF ValidA AND ValidC THEN
      DiffAC := #LoadA - #LoadC;
      IF DiffAC < 0 THEN
         DiffAC := -DiffAC;
      END_IF;
   END_IF;
   IF ValidB AND ValidC THEN
      DiffBC := #LoadB - #LoadC;
      IF DiffBC < 0 THEN
         DiffBC := -DiffBC;
      END_IF;
   END_IF;

   BestMask := 0;
   BestDiff := 0;
   Found := FALSE;

   IF ValidA AND ValidB AND (DiffAB <= 200) THEN
      BestMask := 3;
      BestDiff := DiffAB;
      Found := TRUE;
   END_IF;

   IF ValidA AND ValidC AND (DiffAC <= 200) THEN
      IF (NOT Found) OR (DiffAC < BestDiff) THEN
         BestMask := 5;
         BestDiff := DiffAC;
         Found := TRUE;
      END_IF;
   END_IF;

   IF ValidB AND ValidC AND (DiffBC <= 200) THEN
      IF (NOT Found) OR (DiffBC < BestDiff) THEN
         BestMask := 6;
         BestDiff := DiffBC;
         Found := TRUE;
      END_IF;
   END_IF;

   IF Found THEN
      #PairMask := BestMask;
      IF BestMask = 3 THEN
         #VotedKg := (DINT_TO_LREAL(#LoadA) + DINT_TO_LREAL(#LoadB)) / 2.0;
      ELSIF BestMask = 5 THEN
         #VotedKg := (DINT_TO_LREAL(#LoadA) + DINT_TO_LREAL(#LoadC)) / 2.0;
      ELSE
         #VotedKg := (DINT_TO_LREAL(#LoadB) + DINT_TO_LREAL(#LoadC)) / 2.0;
      END_IF;
      #LoadFault := FALSE;
   ELSE
      #PairMask := 0;
      #VotedKg := 0.0;
      #LoadFault := TRUE;
   END_IF;

   IF #LoadFault THEN
      #Overload := FALSE;
   ELSE
      #Overload := (#VotedKg > 10000.0);
   END_IF;

   #ReleasePermit := #ReleaseReq AND #BarrierReady AND (NOT #Overload) AND (NOT #LoadFault);

END_FUNCTION_BLOCK
