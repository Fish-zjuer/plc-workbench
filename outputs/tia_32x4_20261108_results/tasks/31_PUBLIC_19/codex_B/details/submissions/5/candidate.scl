FUNCTION_BLOCK "Q19"
VERSION : 0.1
VAR_INPUT
    ManualMode : BOOL;
    SingleStepMode : BOOL;
    SingleCycleMode : BOOL;
    ContinuousMode : BOOL;
    EmergencyStop : BOOL;
    Start : BOOL;
    DownButton : BOOL;
    UpButton : BOOL;
    LeftButton : BOOL;
    RightButton : BOOL;
    GripButton : BOOL;
    ReleaseButton : BOOL;
    DownLimitSwitch : BOOL;
    UpLimitSwitch : BOOL;
    LeftLimitSwitch : BOOL;
    RightLimitSwitch : BOOL;
    GripLimitSwitch : BOOL;
    ReleaseLimitSwitch : BOOL;
END_VAR
VAR_OUTPUT
    MoveDown : BOOL;
    MoveUp : BOOL;
    MoveLeft : BOOL;
    MoveRight : BOOL;
    ActivateGrip : BOOL;
    ActivateRelease : BOOL;
END_VAR
VAR
    Step : INT := 0;
    StartPrev : BOOL := FALSE;
    AutoRun : BOOL := FALSE;
    ManCmd : INT := 0;
    CmdId : INT := 0;
    ManLimit : BOOL := FALSE;
    ActLimit : BOOL := FALSE;
END_VAR
BEGIN
    // ---- rising edge of the start button ----
    IF #Start AND NOT #StartPrev THEN
        IF (#Step <= 0) OR (#Step >= 9) THEN
            // the sequence is waiting for an operator confirmation
            #Step := 1;
            #AutoRun := TRUE;
        END_IF;
    END_IF;
    #StartPrev := #Start;

    // ---- action requested from the manual control panel ----
    IF #DownButton THEN
        #ManCmd := 1;
    ELSIF #UpButton THEN
        #ManCmd := 2;
    ELSIF #LeftButton THEN
        #ManCmd := 3;
    ELSIF #RightButton THEN
        #ManCmd := 4;
    ELSIF #GripButton THEN
        #ManCmd := 5;
    ELSIF #ReleaseButton THEN
        #ManCmd := 6;
    ELSE
        #ManCmd := 0;
    END_IF;

    CASE #ManCmd OF
        1: #ManLimit := #DownLimitSwitch;
        2: #ManLimit := #UpLimitSwitch;
        3: #ManLimit := #LeftLimitSwitch;
        4: #ManLimit := #RightLimitSwitch;
        5: #ManLimit := #GripLimitSwitch;
        6: #ManLimit := #ReleaseLimitSwitch;
    ELSE
        #ManLimit := TRUE;
    END_CASE;

    // ---- automatic program: Down, Grip, Up, Right, Down, Release, Up, Left ----
    IF NOT #EmergencyStop THEN
        // an emergency stop interrupts every action and the running sequence
        #Step := 0;
        #AutoRun := FALSE;
    ELSIF #ManualMode THEN
        // manual operation: the automatic program is idle
        #Step := 0;
        #AutoRun := FALSE;
    ELSIF #SingleStepMode OR #SingleCycleMode OR #ContinuousMode THEN
        IF (#Step >= 9) AND (#SingleCycleMode OR #ContinuousMode) THEN
            // end of the cycle reached
            #Step := 9;
        END_IF;
        CASE #Step OF
            1:
                IF #DownLimitSwitch THEN
                    #Step := 2;
                END_IF;
            2:
                IF #GripLimitSwitch THEN
                    #Step := 3;
                END_IF;
            3:
                IF #UpLimitSwitch THEN
                    #Step := 4;
                END_IF;
            4:
                IF #RightLimitSwitch THEN
                    #Step := 5;
                END_IF;
            5:
                IF #DownLimitSwitch THEN
                    #Step := 6;
                END_IF;
            6:
                IF #ReleaseLimitSwitch THEN
                    #Step := 7;
                END_IF;
            7:
                IF #UpLimitSwitch THEN
                    #Step := 8;
                END_IF;
            8:
                IF #LeftLimitSwitch THEN
                    #Step := 9;
                END_IF;
        END_CASE;
        IF (#Step = 9) AND #ContinuousMode THEN
            // continuous operation repeats the handling cycle
            #Step := 1;
            #AutoRun := TRUE;
        END_IF;
    ELSE
        // no mode selected
        #Step := 0;
        #AutoRun := FALSE;
    END_IF;

    // ---- automatic action belonging to the current step ----
    CASE #Step OF
        1: #CmdId := 1;
        2: #CmdId := 5;
        3: #CmdId := 2;
        4: #CmdId := 4;
        5: #CmdId := 1;
        6: #CmdId := 6;
        7: #CmdId := 2;
        8: #CmdId := 3;
    ELSE
        #CmdId := 0;
    END_CASE;

    CASE #CmdId OF
        1: #ActLimit := #DownLimitSwitch;
        2: #ActLimit := #UpLimitSwitch;
        3: #ActLimit := #LeftLimitSwitch;
        4: #ActLimit := #RightLimitSwitch;
        5: #ActLimit := #GripLimitSwitch;
        6: #ActLimit := #ReleaseLimitSwitch;
    ELSE
        #ActLimit := TRUE;
    END_CASE;

    // ---- output decoding ----
    IF #ManualMode THEN
        // manual action: running while the button is held and not yet in position
        IF (NOT #EmergencyStop) OR #ManLimit THEN
            #ManCmd := 0;
        END_IF;
        #MoveDown := (#ManCmd = 1);
        #MoveUp := (#ManCmd = 2);
        #MoveLeft := (#ManCmd = 3);
        #MoveRight := (#ManCmd = 4);
        #ActivateGrip := (#ManCmd = 5);
        #ActivateRelease := (#ManCmd = 6);
    ELSE
        // no automatic command when idle or after the completed cycle
        IF (NOT #EmergencyStop) OR #ActLimit OR (#Step <= 0) OR (#Step >= 9) THEN
            #CmdId := 0;
        END_IF;
        #MoveDown := (#CmdId = 1);
        #MoveUp := (#CmdId = 2);
        #MoveLeft := (#CmdId = 3);
        #MoveRight := (#CmdId = 4);
        #ActivateGrip := (#CmdId = 5);
        #ActivateRelease := (#CmdId = 6);
    END_IF;
END_FUNCTION_BLOCK
