FUNCTION_BLOCK "FB_HmiAccess"
  VERSION : 0.1

  VAR_INPUT
    SessionValid : BOOL;
    Role : USINT;
    Page : USINT;
    WriteReq : BOOL;
    WriteValue : LREAL;
  END_VAR

  VAR_OUTPUT
    ViewAllowed : BOOL;
    WriteAllowed : BOOL;
    Accepted : BOOL;
    Denied : BOOL;
    ParamValue : LREAL := 0.0;
  END_VAR

BEGIN
    IF SessionValid THEN
        CASE Role OF
            1:
                IF (Page = 1) OR (Page = 2) THEN
                    ViewAllowed := TRUE;
                ELSE
                    ViewAllowed := FALSE;
                END_IF;
                WriteAllowed := FALSE;
            2:
                IF (Page = 1) OR (Page = 2) OR (Page = 4) THEN
                    ViewAllowed := TRUE;
                ELSE
                    ViewAllowed := FALSE;
                END_IF;
                WriteAllowed := (Page = 4);
            3:
                ViewAllowed := (Page >= 1) AND (Page <= 4);
                WriteAllowed := (Page = 4);
            ELSE
                ViewAllowed := FALSE;
                WriteAllowed := FALSE;
            END_CASE;
    ELSE
        ViewAllowed := FALSE;
        WriteAllowed := FALSE;
    END_IF;

    IF WriteReq AND WriteAllowed THEN
        IF (WriteValue >= 0.0) AND (WriteValue <= 100.0) THEN
            ParamValue := WriteValue;
            Accepted := TRUE;
            Denied := FALSE;
        ELSE
            Accepted := FALSE;
            Denied := TRUE;
        END_IF;
    ELSIF WriteReq THEN
        Accepted := FALSE;
        Denied := TRUE;
    ELSE
        Accepted := FALSE;
        Denied := FALSE;
    END_IF;
END_FUNCTION_BLOCK
