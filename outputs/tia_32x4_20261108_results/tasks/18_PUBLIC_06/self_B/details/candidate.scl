FUNCTION_BLOCK "BlowerControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT
    DO_LOW : BOOL; // Dissolved oxygen is below its threshold and aeration is needed.
    AERATION_E_STOP_NC : BOOL; // TRUE means the emergency stop is inactive; FALSE means it is active.
END_VAR

VAR_OUTPUT
    BLOWER_RUN : BOOL; // Blower motor-contactor run command.
    AERATION_BLOWER_CYCLE_COUNT : UINT; // Count of actual blower starts.
END_VAR

VAR
    timerStartDelay : TON_TIME;
    prevBlowerRun : BOOL;
    eligible : BOOL;
END_VAR

BEGIN
    // Determine eligibility: both conditions must be true
    #eligible := #DO_LOW AND #AERATION_E_STOP_NC;

    // Emergency Stop or Loss of Demand immediately disables output and resets timer
    IF NOT #eligible THEN
        #BLOWER_RUN := FALSE;
        // Reset timer by calling it with IN = FALSE
        #timerStartDelay(IN := FALSE, PT := T#5s);
    ELSE
        // Start the delay timer when eligible
        #timerStartDelay(IN := TRUE, PT := T#5s);
        
        // Allow blower to run only after delay has elapsed
        IF #timerStartDelay.Q THEN
            #BLOWER_RUN := TRUE;
        ELSE
            #BLOWER_RUN := FALSE;
        END_IF;
    END_IF;

    // Cycle counting logic: Increment on FALSE -> TRUE transition
    IF (#prevBlowerRun = FALSE) AND (#BLOWER_RUN = TRUE) THEN
        #AERATION_BLOWER_CYCLE_COUNT := #AERATION_BLOWER_CYCLE_COUNT + 1;
    END_IF;

    // Update previous state for next scan
    #prevBlowerRun := #BLOWER_RUN;

END_FUNCTION_BLOCK