FUNCTION_BLOCK "BlowerControl"
VERSION : 0.1

VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR

VAR_OUTPUT
    BLOWER_RUN : BOOL;
    AERATION_BLOWER_CYCLE_COUNT : UINT;
END_VAR

VAR
    startTimer : TON;
    prevBlowerRun : BOOL;
END_VAR

BEGIN
    #BLOWER_RUN := FALSE;

    #startTimer(IN := #DO_LOW AND #AERATION_E_STOP_NC,
                PT := T#5s);

    IF #startTimer.Q THEN
        #BLOWER_RUN := TRUE;
    END_IF;

    IF #BLOWER_RUN AND NOT #prevBlowerRun THEN
        #AERATION_BLOWER_CYCLE_COUNT := #AERATION_BLOWER_CYCLE_COUNT + 1;
    END_IF;

    #prevBlowerRun := #BLOWER_RUN;

END_FUNCTION_BLOCK