FUNCTION_BLOCK "BlowerControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR

VAR_OUTPUT
    BLOWER_RUN : BOOL;
    AERATION_BLOWER_CYCLE_COUNT : UINT;
END_VAR

VAR
    startTimer : TON_TIME;
    eligible : BOOL;
    delayReady : BOOL;
    runPrev : BOOL;
END_VAR

BEGIN
    #eligible := #DO_LOW AND #AERATION_E_STOP_NC;

    #startTimer.TON(IN := #eligible,
                    PT := T#5s);

    #delayReady := #startTimer.Q;

    IF #eligible AND #delayReady THEN
        #BLOWER_RUN := TRUE;
    ELSE
        #BLOWER_RUN := FALSE;
    END_IF;

    IF #BLOWER_RUN AND NOT #runPrev THEN
        IF #AERATION_BLOWER_CYCLE_COUNT < 65535 THEN
            #AERATION_BLOWER_CYCLE_COUNT := #AERATION_BLOWER_CYCLE_COUNT + 1;
        END_IF;
    END_IF;

    #runPrev := #BLOWER_RUN;
END_FUNCTION_BLOCK