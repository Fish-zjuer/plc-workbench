FUNCTION_BLOCK "FB_SpectrometerQualification"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Maintenance : BOOL;
    CalibDone : BOOL;
    MeasureReq : BOOL;
END_VAR
VAR_OUTPUT
    State : USINT := 0;
    CalibReq : BOOL := TRUE;
    MaintLamp : BOOL := FALSE;
    MeasurePermit : BOOL := FALSE;
END_VAR
VAR
    StateInternal : USINT := 0;
END_VAR
BEGIN
    IF #Maintenance THEN
        #StateInternal := 2;
    ELSIF #StateInternal = 2 THEN
        #StateInternal := 0;
    ELSIF (#StateInternal = 0) AND #CalibDone THEN
        #StateInternal := 1;
    END_IF;

    #State := #StateInternal;
    #CalibReq := (#StateInternal = 0);
    #MaintLamp := (#StateInternal = 2);
    #MeasurePermit := #MeasureReq AND (#StateInternal = 1);
END_FUNCTION_BLOCK