FUNCTION_BLOCK "FB_SpectrometerQualification"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
  Maintenance : BOOL;
  CalibDone : BOOL;
  MeasureReq : BOOL;
END_VAR
VAR_OUTPUT
  State : USINT;
  CalibReq : BOOL;
  MaintLamp : BOOL;
  MeasurePermit : BOOL;
END_VAR
VAR
  initDone : BOOL := FALSE;
END_VAR
VAR_TEMP
  preState : USINT;
END_VAR
BEGIN
  IF NOT #initDone THEN
      #State := 0;
      #CalibReq := TRUE;
      #MaintLamp := FALSE;
      #MeasurePermit := FALSE;
      #initDone := TRUE;
  END_IF;

  #preState := #State;

  IF #Maintenance THEN
      #State := 2;
  ELSIF #preState = 2 THEN
      #State := 0;
  ELSIF (#preState = 0) AND #CalibDone THEN
      #State := 1;
  ELSE
      #State := #preState;
  END_IF;

  #CalibReq := (#State = 0);
  #MaintLamp := (#State = 2);
  #MeasurePermit := #MeasureReq AND (#State = 1);
END_FUNCTION_BLOCK