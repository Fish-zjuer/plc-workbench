TYPE ST_Recipe
VERSION : 0.1
   STRUCT
      recipeID : INT;
      ingredientType : INT;
      ingredientRatio : REAL;
      productionTemperature : REAL;
   END_STRUCT;
END_TYPE

FUNCTION_BLOCK "Q17"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
   addRecipe : BOOL;
   deleteRecipe : BOOL;
   modifyRecipe : BOOL;
   queryRecipe : BOOL;
   recipeIn : ST_Recipe;
END_VAR
VAR_OUTPUT
   recipeAdded : BOOL;
   recipeDeleted : BOOL;
   recipeModified : BOOL;
   recipeQueryResult : ST_Recipe;
   error : BOOL;
   status : WORD;
END_VAR
VAR_IN_OUT
   recipe : ARRAY[1..10] OF ST_Recipe;
END_VAR
VAR_TEMP
   i : INT;
   foundIndex : INT;
   freeIndex : INT;
END_VAR
BEGIN
   #error := FALSE;
   #status := 16#0000;
   #recipeAdded := FALSE;
   #recipeDeleted := FALSE;
   #recipeModified := FALSE;

   #foundIndex := 0;
   #freeIndex := 0;

   FOR #i := 1 TO 10 DO
      IF (#freeIndex = 0) AND (#recipe[#i].recipeID = 0) THEN
         #freeIndex := #i;
      END_IF;
      IF (#recipeIn.recipeID <> 0) AND (#recipe[#i].recipeID = #recipeIn.recipeID) THEN
         #foundIndex := #i;
      END_IF;
   END_FOR;

   IF #addRecipe THEN
      IF #foundIndex <> 0 THEN
         #error := TRUE;
         #status := 16#8002;
      ELSIF #freeIndex = 0 THEN
         #error := TRUE;
         #status := 16#8003;
      ELSE
         #recipe[#freeIndex] := #recipeIn;
         #recipeAdded := TRUE;
      END_IF;
   ELSIF #deleteRecipe THEN
      IF #foundIndex = 0 THEN
         #error := TRUE;
         #status := 16#8004;
      ELSE
         #recipe[#foundIndex].recipeID := 0;
         #recipeDeleted := TRUE;
      END_IF;
   ELSIF #modifyRecipe THEN
      IF #foundIndex = 0 THEN
         #error := TRUE;
         #status := 16#8005;
      ELSE
         #recipe[#foundIndex] := #recipeIn;
         #recipeModified := TRUE;
      END_IF;
   ELSIF #queryRecipe THEN
      IF #foundIndex = 0 THEN
         #error := TRUE;
         #status := 16#8001;
      ELSE
         #recipeQueryResult := #recipe[#foundIndex];
      END_IF;
   END_IF;
END_FUNCTION_BLOCK