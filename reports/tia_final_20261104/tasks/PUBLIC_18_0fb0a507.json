      },
      {
        "id": "P04",
        "formula": "G(!reset & enqueueRise & full -> queueHeld & itemHeld & status8002)"
      },
      {
        "id": "P05",
        "formula": "G(!reset & dequeueRise & notEmpty -> queueAfterPopOK & statusZero)"
      },
      {
        "id": "P06",
