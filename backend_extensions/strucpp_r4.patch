diff --git a/src/runtime/include/iec_variant.hpp b/src/runtime/include/iec_variant.hpp
new file mode 100644
index 0000000..3113f1d
--- /dev/null
+++ b/src/runtime/include/iec_variant.hpp
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-only WITH STruCpp-runtime-exception
+// PLC Workbench extension, 2026. Descriptor ABI is local to this backend.
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <typeinfo>
+#include <limits>
+#include "iec_var.hpp"
+#include "iec_traits.hpp"
+
+namespace strucpp {
+class IEC_VARIANT {
+    void* data_ = nullptr;
+    const std::type_info* type_ = nullptr;
+    std::size_t width_ = 0;
+    int64_t count_ = 0;
+    bool array_ = false;
+    void (*copy_)(void*, const void*) = nullptr;
+
+    template<class T> void bind_impl(T* data, int64_t count, bool array) {
+        data_=data;type_=&typeid(T);width_=sizeof(T);count_=count;array_=array;
+        copy_=[](void* to,const void* from){ *static_cast<T*>(to)=*static_cast<const T*>(from); };
+    }
+public:
+    template<class T> void bind_scalar(T& value) { bind_impl(&value,1,false); }
+    template<class T> void bind_array(T* values,int64_t count) { bind_impl(values,count,true); }
+    bool valid() const { return data_ && type_ && count_>0 && copy_; }
+    int64_t count() const { return valid() && array_ ? count_ : 0; }
+    bool compatible(const IEC_VARIANT& item) const {
+        return valid() && array_ && item.valid() && !item.array_ && item.count_==1 &&
+               *type_==*item.type_ && width_==item.width_;
+    }
+    bool read(int64_t index,IEC_VARIANT& item) const {
+        if(!compatible(item) || index<0 || index>=count_) return false;
+        copy_(item.data_,static_cast<const char*>(data_)+static_cast<std::size_t>(index)*width_);
+        return true;
+    }
+    bool write(int64_t index,const IEC_VARIANT& item) {
+        if(!compatible(item) || index<0 || index>=count_) return false;
+        copy_(static_cast<char*>(data_)+static_cast<std::size_t>(index)*width_,item.data_);
+        return true;
+    }
+};
+inline IEC_DINT PV_COUNT(const IEC_VARIANT& buffer) {
+    const auto count=buffer.count();
+    return count<=std::numeric_limits<int32_t>::max()?static_cast<int32_t>(count):0;
+}
+inline IEC_BOOL PV_COMPATIBLE(const IEC_VARIANT& buffer,const IEC_VARIANT& item) { return buffer.compatible(item); }
+template<class T> inline IEC_BOOL PV_READ(const IEC_VARIANT& buffer,T index,IEC_VARIANT& item) { return buffer.read(iec_unwrap(index),item); }
+template<class T> inline IEC_BOOL PV_WRITE(IEC_VARIANT& buffer,T index,const IEC_VARIANT& item) { return buffer.write(iec_unwrap(index),item); }
+}
